{
  "name": "mcpforge",
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/copy-templates.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@clack/prompts": "^1.8.1",
    "@mcpforge/core": "1.1.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "handlebars": "^4.7.10",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
