{
  "name": "mcpforge",
  "version": "2.0.0-rc.1",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsup --config tsup.config.ts && node ./scripts/copy-templates.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "@apidevtools/swagger-parser": "^13.1.0",
    "@clack/prompts": "^1.8.1",
    "@mcpforge/core": "2.0.0-rc.1",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "handlebars": "^4.7.10",
    "zod": "^4.6.6",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
