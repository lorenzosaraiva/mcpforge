{
  "name": "mcpforge",
  "version": "1.1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && node ./scripts/copy-templates.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@clack/prompts": "^0.11.0",
    "@mcpforge/core": "1.1.0",
    "commander": "^14.0.1",
    "cross-spawn": "^7.0.6",
    "handlebars": "^4.7.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
