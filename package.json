{
  "name": "mcpforge",
  "private": true,
  "type": "module",
  "version": "2.0.0-rc.1",
  "description": "Generate production-ready MCP servers from OpenAPI specs.",
  "author": "Lorenzo",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lorenzosaraiva/mcpforge.git"
  },
  "keywords": [
    "mcp",
    "openapi",
    "ai",
    "agent",
    "claude",
    "cursor",
    "model-context-protocol"
  ],
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "2.1.3",
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "npm run build -w @mcpforge/core && npm run build -w mcpforge && tsc -p scripts/tsconfig.json",
    "dev": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8",
    "registry:validate": "node scripts/validate-registry.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "benchmark:contracts": "tsx scripts/evaluate-task-packs.ts --mode contract",
    "benchmark:model": "tsx scripts/evaluate-task-packs.ts --mode model"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "esbuild": "0.28.2"
  }
}
